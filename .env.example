# ─────────────────────────────────────────────────────────────────────────
# Tare Zameen Foundation — environment configuration
# Copy this file to `.env` (local dev) and fill in real values.
# NEVER commit `.env` — it is already covered by .gitignore's `*.local` /
# you should also add a plain `.env` entry if you don't already ignore it.
#
# Only variables prefixed VITE_ are exposed to the browser bundle (handled by
# @lovable.dev/vite-tanstack-config). Everything below is server-only and is
# read exclusively inside TanStack Start server functions / server routes.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Project Settings → API → service_role key. Full-access, bypasses RLS.
# Used ONLY by trusted server-side code (donation writes, notification
# sending, admin log queries). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string → "Session pooler" (Drizzle
# needs a direct/pooled Postgres connection, not the PostgREST HTTP API).
DATABASE_URL=

# ── Email (Module 1 — transactional email) ─────────────────────────────
# EMAIL_PROVIDER=resend enables real sending via the Resend HTTP API.
# Leave unset (or EMAIL_PROVIDER=console) to use the dev-safe console
# provider, which renders and logs the full message instead of calling any
# external service. Notifications sent this way are logged with
# provider="console" and are never reported as externally delivered.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Tare Zameen Foundation <donations@tarezameenfoundation.org>"

# ── WhatsApp (Module 1 — optional channel) ──────────────────────────────
# WHATSAPP_PROVIDER=twilio enables real sending via the Twilio WhatsApp API.
# WHATSAPP_PROVIDER=cloud_api enables the WhatsApp Business Cloud API.
# Leave unset (or WHATSAPP_PROVIDER=disabled) and the channel is disabled
# system-wide: every WhatsApp send is logged as SKIPPED with reason
# "WhatsApp provider not configured" — no message is ever faked as sent.
WHATSAPP_PROVIDER=disabled

# Twilio (used when WHATSAPP_PROVIDER=twilio)
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
# Twilio WhatsApp-enabled sender, E.164 with or without the whatsapp:
# prefix (normalized either way), e.g. +14155238886 (Twilio's public
# sandbox number for testing).
WHATSAPP_TWILIO_FROM=

# Optional. WhatsApp Business Platform policy requires an approved Content
# Template (not free-form text) for business-initiated messages — i.e.
# whenever there's no open 24-hour session with the recipient. If Twilio
# rejects sends with "ContentSid Required", create/locate a Content
# Template in the Twilio Console (Content Template Builder) and set its
# SID here (starts with "HX..."). The template's first variable receives
# the full rendered message text. Leave unset to use free-form Body only
# (works within an active session).
WHATSAPP_TWILIO_CONTENT_SID=

# WhatsApp Business Cloud API (used when WHATSAPP_PROVIDER=cloud_api)
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# ── Notification behavior ───────────────────────────────────────────────
# development: caps real sends to NOTIFICATION_TEST_RECIPIENTS and tags
#              every message with a "[TEST]" marker.
# production:  sends to real donor-provided email/phone.
NOTIFICATION_MODE=development

# Comma-separated allowlist of email addresses / E.164 phone numbers that
# may receive real sends while NOTIFICATION_MODE=development. Any recipient
# outside this list is SKIPPED (never silently dropped without a log entry).
NOTIFICATION_TEST_RECIPIENTS=

# How many days before a recurring donation's scheduled charge date the
# RECURRING_DONATION_REMINDER job should fire.
REMINDER_DAYS_BEFORE=3

# Master switch for the monthly impact summary job.
MONTHLY_IMPACT_ENABLED=true

# ── Module 2 — lead nurture & lapsed-donor re-engagement ────────────────
# How many days with no successful donation before a past donor is
# considered "lapsed" and gets a LAPSED_DONOR_REENGAGEMENT check-in.
# A donor with an active recurring donation is never considered lapsed.
LAPSED_DONOR_DAYS=60

# How many days after a partnership inquiry (see src/functions/partner.ts)
# with no reply before a lead gets an automated LEAD_FOLLOWUP nudge.
LEAD_FOLLOWUP_DAYS=3

# Shared secret an external scheduler (cron-job.org, GitHub Actions,
# Cloudflare Cron Trigger, etc.) must send as `Authorization: Bearer
# <secret>` when calling /api/cron/* endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_CRON_SECRET=

# Base URL used to build links inside notifications (dashboard, receipts).
APP_URL=https://lagged-catching-prayer.ngrok-free.dev

# Comma-separated donor email addresses to grant staff/admin access to the
# internal notification log view (checked against the authenticated donor's
# email — see docs/MODULE1_NOTIFICATIONS.md for the future real-RBAC path).
STAFF_ADMIN_EMAILS=

# Inbox that receives partnership-inquiry form submissions (/partner).
# Defaults to info@tarezameenfoundation.org if unset. Uses the same
# EMAIL_PROVIDER as Module 1.
PARTNERSHIP_INQUIRY_EMAIL=
